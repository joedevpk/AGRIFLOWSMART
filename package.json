{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sql": "bash supabase/tests/run-all.sh",
    "db:check": "bash scripts/check-migrations.sh",
    "check": "npm run typecheck && npm run typecheck:edge && npm run lint && npm test && npm run db:check && npm run build",
    "typecheck:edge": "tsc -p tsconfig.edge.json",
    "test:e2e": "playwright test",
    "build:mobile": "node scripts/mobile-checks.mjs env && vite build && node scripts/mobile-checks.mjs bundle",
    "cap:sync": "npm run build:mobile && cap sync && node scripts/mobile-checks.mjs native",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:run:android": "npm run cap:sync && cap run android",
    "android:debug": "npm run cap:sync && node scripts/android-tools.mjs gradle assembleDebug",
    "android:bundle": "npm run cap:sync && node scripts/android-tools.mjs gradle bundleRelease",
    "check:mobile-native": "node scripts/mobile-checks.mjs native",
    "android:doctor": "node scripts/android-tools.mjs doctor"
  },
  "dependencies": {
    "@capacitor/android": "~7.6.9",
    "@capacitor/app": "~7.1.2",
    "@capacitor/browser": "~7.0.5",
    "@capacitor/camera": "~7.0.5",
    "@capacitor/core": "~7.6.9",
    "@capacitor/filesystem": "~7.1.9",
    "@capacitor/geolocation": "~7.1.8",
    "@capacitor/ios": "~7.6.9",
    "@capacitor/share": "~7.0.4",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "~7.6.9",
    "@eslint/js": "^9.9.1",
    "@fontsource/manrope": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "opentype.js": "^2.0.0",
    "postcss": "^8.4.35",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
