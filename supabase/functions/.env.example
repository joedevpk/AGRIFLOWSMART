# AgriFlow RDC — Secrets des Edge Functions (payment-initiate, payment-webhook, payment-verify, payment-refund, order-confirmation-cron)
#
# CE FICHIER NE CONTIENT AUCUN SECRET ET NE DOIT JAMAIS EN CONTENIR. Utilisation :
#   1. cp supabase/functions/.env.example supabase/functions/.env     (ignoré par Git)
#   2. remplir les vraies valeurs dans supabase/functions/.env
#   3. supabase secrets set --env-file supabase/functions/.env        (vers le projet lié : staging OU production, jamais les deux)
#
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont fournies automatiquement par Supabase à chaque fonction :
# ne pas les redéfinir (et ne JAMAIS coller la clé service_role dans un fichier versionné).
# Un projet Supabase = un environnement : staging et production ont chacun leurs propres secrets.

# --- CinetPay (compte marchand — menu « Intégrations » sur cinetpay.com) ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
# Valeur par défaut valable ; ne la changer que sur indication de CinetPay.
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com

# Activation EXPLICITE du paiement en ligne. Absent ou différent de « true » : aucun NOUVEAU paiement n'est créé (les notifications
# de paiements déjà initiés restent traitées). Ne mettre « true » qu'après avoir obtenu des clés RÉELLES et réalisé les tests de docs/CINETPAY-INTEGRATION.md.
PAYMENTS_ONLINE_ENABLED=false
# Carte bancaire : opt-in distinct, à n'activer qu'après confirmation écrite de CinetPay (disponibilité en CDF non confirmée).
CINETPAY_CARD_ENABLED=false
# Prestataire (défaut : cinetpay). Toute autre valeur désactive le paiement en ligne.
# PAYMENT_PROVIDER=cinetpay

# --- Application ---
# URL publique du frontend : construit la return_url CinetPay ({FRONTEND_URL}/payment/result/{reference}) ET limite le CORS des fonctions
# à ce seul site. Obligatoire en production (sans elle, CORS = « * »).
FRONTEND_URL=
SITE_URL=

# --- Cron de confirmation des commandes ---
# Secret partagé : la fonction refuse tout appel sans l'en-tête `x-cron-secret` correspondant (fail closed). Générer : openssl rand -hex 32
CRON_SECRET=

# --- E-mail (OPTIONNEL) : sans ces deux valeurs le canal e-mail est ignoré, aucun e-mail n'est prétendu envoyé ---
RESEND_API_KEY=
EMAIL_FROM=
